<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget picker preview on Android 12+. Mirrors NextLaunchWidgetContent with a sample launch, since
  nothing may have been downloaded yet.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/next_launch_widget_title"
        android:textColor="#FFCFC2FF"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/next_launch_widget_preview_mission"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/next_launch_widget_preview_vehicle"
        android:textColor="#FFB8C0D9"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:text="@string/next_launch_widget_preview_countdown"
        android:textColor="#FFCFC2FF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/next_launch_widget_preview_net"
        android:textColor="#FFB8C0D9"
        android:textSize="12sp" />

</LinearLayout>
