<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget picker preview on Android 12+. Mirrors EarthTodayWidgetContent with an illustration in
  place of the photo, which does not exist until the app has synced.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/earth_widget_preview_art" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/earth_widget_preview_caption"
        android:textColor="#FFB8C0D9"
        android:textSize="11sp" />

</LinearLayout>
