<?xml version="1.0" encoding="utf-8"?>
<!--
  No periodic update: the widget is refreshed by the sync worker every time new data lands in the
  cache, which is the only time its content can change.

  The preview layout and target cell size are Android 12+ only; older launchers fall back to
  previewImage and minWidth/minHeight, hence the UnusedAttribute suppression.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/latest_apod_widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/latest_apod_widget_preview_art"
    android:previewLayout="@layout/latest_apod_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
