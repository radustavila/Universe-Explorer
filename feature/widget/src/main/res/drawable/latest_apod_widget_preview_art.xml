    android:width="180dp"
    android:height="180dp"
    android:viewportWidth="180"
    android:viewportHeight="180">

    <path android:pathData="M0,0h180v180h-180z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="#FF07070D"
                android:endX="0"
                android:endY="180"
                android:startColor="#FF1B2340"
                android:startX="0"
                android:startY="0"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Moon with an earthshine-lit night side. -->
