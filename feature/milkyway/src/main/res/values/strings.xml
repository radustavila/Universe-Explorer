<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="milky_way_title">Milky Way planner</string>
    <string name="milky_way_back">Back</string>

    <string name="milky_way_place_prompt">Save your place to see when the core of the Milky Way is up in a dark, moonless sky.</string>
    <string name="milky_way_place_action">Set your place</string>

    <!-- The best window of tonight or of the next good night. -->
    <string name="milky_way_tonight">Tonight</string>
    <string name="milky_way_next_night">Next good night: %1$s</string>
    <string name="milky_way_core_position">Core %1$d° high in the %2$s at %3$s</string>
    <string name="milky_way_window_length">%1$s of dark, moonless sky with the core up</string>
    <string name="milky_way_show_on_sky_map">Show the core on the sky map</string>

    <!-- When there is no window in the coming month. -->
    <string name="milky_way_too_low_title">The core stays too low here</string>
    <string name="milky_way_too_low_description">From your latitude the centre of the Milky Way never gets more than %1$d° above the horizon, and it needs 10° to clear the haze.</string>
    <string name="milky_way_never_rises_description">From your latitude the centre of the Milky Way never rises.</string>
    <string name="milky_way_no_darkness_title">Too light for the Milky Way</string>
    <string name="milky_way_no_darkness_description">The Sun never gets 18° below the horizon in the coming nights, so the sky never gets fully dark.</string>
    <string name="milky_way_by_day_title">The core is up by day</string>
    <string name="milky_way_by_day_description">At this time of year the core of the Milky Way is above the horizon only while the Sun is up.</string>
    <string name="milky_way_moonlight_title">The Moon is in the way</string>
    <string name="milky_way_twilight_below">The twilight, golden and blue hour times below still work.</string>
    <string name="milky_way_moonlight_description">On every night in the coming month that the core is up in a dark sky, a bright Moon is up too.</string>

    <!-- %1$s: one or more month ranges, e.g. "March to October". -->
    <string name="milky_way_season">Core season here: %1$s, best around the new Moon.</string>
    <string name="milky_way_season_all_year">all year</string>
    <string name="milky_way_month_range">%1$s to %2$s</string>
    <string name="milky_way_month_list_separator">, </string>

