<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Podcast playback (F21) keeps running in the background with lock-screen controls. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Keeps the CPU and Wi-Fi awake while an episode streams with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- Exported without a permission on purpose: the system UI, Bluetooth and wearables bind
             to it as media controllers, and Media3 checks each controller as it connects. -->
        <service
            android:name=".PodcastPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
