<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="new_apod_channel_name">New picture of the day</string>
    <string name="new_apod_channel_description">Announces each new Astronomy Picture of the Day as soon as it has been downloaded.</string>
    <string name="new_apod_notification_title">New Astronomy Picture of the Day</string>
    <string name="aurora_alert_channel_name">Aurora alerts</string>
    <string name="aurora_alert_channel_description">Tells you when the forecast says the aurora may be visible from your place.</string>
    <string name="aurora_alert_title">Aurora may be visible tonight</string>
    <string name="aurora_alert_strength">Kp %1$d</string>
    <string name="aurora_alert_strength_storm">Kp %1$d (%2$s storm)</string>
    <string name="aurora_alert_text">%1$s is forecast from %2$s. From your place the aurora shows at Kp %3$d or more.</string>
    <string name="iss_pass_channel_name">ISS passes</string>
    <string name="iss_pass_channel_description">A reminder a few minutes before the International Space Station passes visibly over your location.</string>
    <string name="iss_pass_notification_title">The ISS passes over you at %1$s</string>
    <string name="iss_pass_notification_text">Look %1$s. It climbs to %2$d° and is visible for about %3$d min.</string>
    <string name="iss_pass_compass_n">north</string>
    <string name="iss_pass_compass_ne">north-east</string>
    <string name="iss_pass_compass_e">east</string>
    <string name="iss_pass_compass_se">south-east</string>
    <string name="iss_pass_compass_s">south</string>
    <string name="iss_pass_compass_sw">south-west</string>
    <string name="iss_pass_compass_w">west</string>
    <string name="iss_pass_compass_nw">north-west</string>
    <string name="sky_event_channel_name">Sky event reminders</string>
    <string name="sky_event_channel_description">The reminders you set in the sky events calendar: eclipses, meteor showers, Moon phases and more.</string>
    <!-- %1$s: a day and time, e.g. "Wed 12 Aug, 19:34". -->
    <string name="sky_event_notification_starts">Starts %1$s from your place.</string>
    <!-- %1$s: a day and time. For instants such as a full Moon or an equinox. -->
    <string name="sky_event_notification_at">%1$s.</string>
    <!-- %1$s: day and time darkness falls; %2$s: the best time to watch. -->
    <string name="sky_event_notification_meteors">Dark from %1$s, best around %2$s. Find a dark spot away from lights.</string>
</resources>
