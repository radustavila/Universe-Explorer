<?xml version="1.0" encoding="utf-8"?>
<!--
  Static launcher shortcuts (long-press the app icon). Each opens an in-app deep link that the
  feature's navigation extension declares (see the *DeepLink objects in :core:model). The intents
  name MainActivity explicitly, so the nasaexplorer:// scheme needs no public intent filter.
  Launchers show the first four or five; the order below is the order of importance.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutId="search"
        android:shortcutLongLabel="@string/shortcut_search_long"
        android:shortcutShortLabel="@string/shortcut_search_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="nasaexplorer://search"
            android:targetClass="com.radustavila.nasaexplorer.MainActivity"
            android:targetPackage="com.radustavila.nasaexplorer" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_today"
        android:shortcutId="today"
        android:shortcutLongLabel="@string/shortcut_today_long"
        android:shortcutShortLabel="@string/shortcut_today_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="nasaexplorer://today"
            android:targetClass="com.radustavila.nasaexplorer.MainActivity"
            android:targetPackage="com.radustavila.nasaexplorer" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_sky"
        android:shortcutId="sky"
        android:shortcutLongLabel="@string/shortcut_sky_long"
        android:shortcutShortLabel="@string/shortcut_sky_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="nasaexplorer://sky"
            android:targetClass="com.radustavila.nasaexplorer.MainActivity"
            android:targetPackage="com.radustavila.nasaexplorer" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_launches"
        android:shortcutId="launches"
        android:shortcutLongLabel="@string/shortcut_launches_long"
        android:shortcutShortLabel="@string/shortcut_launches_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="nasaexplorer://launches"
            android:targetClass="com.radustavila.nasaexplorer.MainActivity"
            android:targetPackage="com.radustavila.nasaexplorer" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_space_weather"
        android:shortcutId="space_weather"
        android:shortcutLongLabel="@string/shortcut_space_weather_long"
        android:shortcutShortLabel="@string/shortcut_space_weather_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="nasaexplorer://spaceweather"
            android:targetClass="com.radustavila.nasaexplorer.MainActivity"
            android:targetPackage="com.radustavila.nasaexplorer" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_earth_map"
        android:shortcutId="earth_map"
        android:shortcutLongLabel="@string/shortcut_earth_map_long"
        android:shortcutShortLabel="@string/shortcut_earth_map_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="nasaexplorer://earthmap"
            android:targetClass="com.radustavila.nasaexplorer.MainActivity"
            android:targetPackage="com.radustavila.nasaexplorer" />
    </shortcut>
</shortcuts>
